{
  "manifest_version": 3,
  "name": "Tenno Link",
  "version": "1.3.0",
  "version_name": "1.3.0 Preview",
  "description": "Independent Warframe profile dashboard, Star Chart companion and AI bridge.",
  "permissions": [
    "cookies",
    "storage",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.warframe.com/*",
    "https://api.warframe.com/*",
    "https://api.warframestat.us/*",
    "https://raw.githubusercontent.com/WFCD/warframe-drop-data/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://warframe.com/*", "https://www.warframe.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "assets/tenno-link-logo-animated.svg"],
      "matches": ["https://warframe.com/*", "https://www.warframe.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tenno Link",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
